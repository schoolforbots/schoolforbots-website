---
// Marks content that is illustrative or still missing, and shows a small tag
// so nobody mistakes it for the real thing. `scripts/check-placeholders.mjs`
// finds usages and checks them against PLACEHOLDERS.md.
interface Props {
  id: string
  kind: '待补' | '示意'
}

const { id, kind } = Astro.props

if (!/^[a-z0-9-]+$/.test(id)) {
  throw new Error(`Placeholder id "${id}" must match ^[a-z0-9-]+$`)
}
if (kind !== '待补' && kind !== '示意') {
  throw new Error(`Placeholder kind "${kind}" must be 待补 or 示意`)
}
---

<slot /><span class="placeholder-tag" data-placeholder={id}>{kind}</span>

<style>
  .placeholder-tag {
    display: inline-block;
    margin-inline-start: 0.35em;
    padding: 0.05em 0.5em;
    border: 1px dashed var(--sfb-highlight);
    border-radius: 0.25em;
    color: var(--sfb-mute);
    font-size: 0.75rem;
    line-height: 1.5;
    vertical-align: middle;
    white-space: nowrap;
  }
</style>
