---
// The homepage's card of the school's numbers, read from the school in the browser
// (lib/school/stats-mount.ts): students in school, the owners behind them, the
// classes, and how long the school has been open (or until it opens). It leads to the live campus page, which has them all
// (components/live/SchoolOverview.astro). Totals only. Until they arrive, or if the
// school cannot be read, each shows a dash.
// Each reads as a phrase: 在校学生 45 名, 注册家长 45 位, 开放班级 4 个, 已经开学 9 天 (离开学还有 2 天 before the
// opening day; the script sets that tile's words).
const tiles = [
  { key: 'students', label: '在校学生', unit: '名' },
  { key: 'owners', label: '注册家长', unit: '位' },
  { key: 'classes', label: '开放班级', unit: '个' },
  { key: 'day', label: '已经开学', unit: '天' },
]
---

<a class="numbers card" href="/live/" data-school-stats data-state="loading" aria-label="学校的数字，去看校园实况">
  <ul>
    {
      tiles.map(({ key, label, unit }) => (
        <li>
          <span class="label" data-stat-label={key}>
            {label}
          </span>
          <span class="figure">
            <span class="value" data-stat={key}>
              —
            </span>
            <span class="unit" data-stat-unit={key}>
              {unit}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
  <p class="unreachable">暂时取不到学校的数字，过一会儿再来看看。</p>
</a>

<script>
  import { mountSchoolStats } from '../../lib/school/stats-mount'
  mountSchoolStats()
</script>

<style>
  .numbers {
    display: block;
    max-width: var(--sfb-home-width);
    margin: 0 auto;
    color: inherit;
    text-decoration: none;
  }
  .card {
    margin-top: 2rem;
    padding: 1rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--sfb-mute);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    gap: 0.125rem;
    justify-items: center;
    margin: 0;
    padding: 0.5rem 0.25rem;
  }
  li + li {
    border-inline-start: 1px solid var(--sfb-line);
  }
  .value {
    color: var(--sfb-ink);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .label {
    color: var(--sfb-mute);
    font-size: 0.875rem;
  }
  .figure {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
  }
  .unit {
    color: var(--sfb-mute);
    font-size: 0.9375rem;
  }
  .unit:empty {
    display: none;
  }
  .unreachable {
    display: none;
    margin: 0.5rem 0 0;
    color: var(--sfb-mute);
    font-size: 0.875rem;
    text-align: center;
  }
  .numbers[data-state='unreachable'] .unreachable {
    display: block;
  }
  @media (max-width: 40rem) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li:nth-child(3) {
      border-inline-start: 0;
    }
  }
</style>
