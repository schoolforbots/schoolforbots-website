---
// The hero's card: the next school day, read from the school in the browser
// (lib/school/next-school-day-mount.ts): which day, the times of its three slots,
// and for each of the three divisions its subject and lesson title, whether or
// not it has students yet. Only what the school writes itself; nothing students say.
import CalendarClock from '@lucide/astro/icons/calendar-clock'
---

<section class="next-day" data-next-school-day aria-labelledby="next-day-title" aria-live="polite">
  <h2 id="next-day-title" class="sr-only">下一个上课日</h2>
  <span class="mark" aria-hidden="true"><CalendarClock size={22} /></span>
  <div class="content" data-next-school-day-body>
    <p class="quiet" data-next-school-day-loading>正在查下一个上课日…</p>
    <noscript><p class="quiet">下一个上课日的安排要在浏览器里打开脚本才能看到。</p></noscript>
  </div>
</section>

<script>
  import { mountNextSchoolDay } from '../../lib/school/next-school-day-mount'
  mountNextSchoolDay()
</script>

<style>
  .next-day {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1.25rem;
    align-items: start;
    max-width: var(--sfb-home-width);
    margin: 0 auto;
    padding: 1.5rem 1.75rem 1.75rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
    box-shadow: 0 0.75rem 2.5rem -0.75rem rgb(90 40 8 / 0.2);
    text-align: start;
  }
  :global(:root[data-theme='dark']) .next-day {
    box-shadow: 0 0.75rem 2.5rem -0.75rem rgb(0 0 0 / 0.7);
  }
  .mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--sfb-line);
    border-radius: 50%;
    background: var(--sfb-bg-soft);
    color: var(--sfb-highlight);
  }
  .content {
    min-width: 0;
    min-height: 2.75rem;
  }
  .content :global(.quiet) {
    margin: 0;
    color: var(--sfb-mute);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .content > :global(.quiet:only-child) {
    padding-top: 0.6rem;
  }

  .content :global(.head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.875rem;
  }
  .content :global(.badge) {
    align-self: center;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--sfb-num-bg);
    color: var(--sfb-num-ink);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .content :global(.badge.live) {
    background: var(--sfb-live-bg);
    color: var(--sfb-live-ink);
  }
  .content :global(.badge.live)::before {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-inline-end: 0.375rem;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 0.12em;
  }
  .content :global(.when) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.625rem;
    margin: 0;
  }
  .content :global(.day) {
    color: var(--sfb-ink);
    font-size: 1.375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
  }
  .content :global(.near) {
    color: var(--sfb-highlight);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .content :global(.study) {
    color: var(--sfb-mute);
    font-size: 0.9375rem;
  }

  /* The day's three slots, the same for every division. */
  .content :global(.slots) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.875rem 0 0;
    padding: 0;
    list-style: none;
  }
  .content :global(.slots li) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .content :global(.slots .slot) {
    color: var(--sfb-ink);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .content :global(.slots .time) {
    color: var(--sfb-ink);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  .content :global(.slots .note) {
    color: var(--sfb-mute);
    font-size: 0.8125rem;
  }
  .content :global(.slots .over .slot),
  .content :global(.slots .over .time) {
    color: var(--sfb-mute);
  }
  .content :global(.slots .live .note) {
    color: var(--sfb-live-ink);
    font-weight: 600;
  }

  .content :global(.divisions) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .content :global(.divisions li) {
    padding: 0.875rem 1rem 1rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.625rem;
    background: var(--sfb-bg-soft);
  }
  .content :global(.division-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .content :global(.division) {
    color: var(--sfb-ink);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .content :global(.subject) {
    padding: 0 0.5rem;
    border: 1px solid color-mix(in srgb, var(--sfb-highlight) 45%, var(--sfb-line));
    border-radius: 999px;
    color: var(--sfb-link);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .content :global(.topic) {
    margin: 0.5rem 0 0;
    color: var(--sfb-ink);
    font-size: 1rem;
    line-height: 1.6;
  }
  .content :global(.topic.quiet) {
    color: var(--sfb-mute);
    font-size: 0.9375rem;
  }

  @media (width < 40rem) {
    .next-day {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.875rem;
      padding: 1.25rem;
      border-radius: 0.75rem;
    }
    .mark {
      display: none;
    }
  }
</style>
