---
// The frame every homepage section below the status strip shares: the same
// space above, the large centred title, an optional line under it, then the
// section's own content and an optional closing link. Other attributes (such as
// the data-* hook the tests find the section by) go on the <section>; a class
// passed in (Astro passes the caller's scope class this way) joins its own.
import ArrowRight from '@lucide/astro/icons/arrow-right'
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'section'>, 'title'> {
  titleId: string
  title: string
  lead?: string
  more?: { label: string; href: string }
}

const { titleId, title, lead, more, class: className, ...attrs } = Astro.props
---

<section class:list={['home-section', 'not-content', className]} aria-labelledby={titleId} {...attrs}>
  <h2 data-display-title id={titleId}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
  <slot />
  {
    more && (
      <p class="more">
        <a href={more.href}>
          {more.label}
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      </p>
    )
  }
</section>

<style>
  .home-section {
    /* The space between the title (or the line under it) and what follows; the sections' own styles use it. */
    --home-title-gap: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
    margin: 0;
    padding-top: clamp(4rem, 2.5rem + 5vw, 7rem);
  }

  h2 {
    margin: 0;
    color: var(--sfb-ink);
    font-size: clamp(1.625rem, 1.3rem + 1.3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .lead {
    max-width: 32em;
    margin: 0.75rem auto 0;
    color: var(--sfb-mute);
    font-size: 1rem;
    line-height: 1.75;
    text-align: center;
    /* Break at punctuation and spaces, not inside a phrase. */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .more {
    margin: 1.5rem 0 0;
    text-align: center;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--sfb-link);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .more a:hover {
    text-decoration-thickness: 2px;
  }
  .more :global(svg) {
    flex: none;
  }
</style>
