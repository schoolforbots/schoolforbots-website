---
// Homepage blocks rise into place as they scroll into view. A block marked
// data-reveal fades in and lifts 1rem; inside it, the children of a
// data-reveal-stagger list follow one after another. The page is only hidden
// when the motion can run: the inline script marks the root before the page
// paints, and only when the reader allows motion and the browser can watch for
// scrolling. Without script, with reduced motion or in print, everything shows.
---

<script is:inline>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('reveal-on')
  }
</script>

<script>
  const root = document.documentElement
  if (root.classList.contains('reveal-on')) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.setAttribute('data-shown', '')
          seen.unobserve(entry.target)
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    )
    for (const el of document.querySelectorAll('[data-reveal]')) seen.observe(el)
    // A reader who switches reduced motion on mid-visit sees everything at once.
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      if (e.matches) root.classList.remove('reveal-on')
    })
  }
</script>

<style is:global>
  .reveal-on [data-reveal],
  .reveal-on [data-reveal] [data-reveal-stagger] > * {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .reveal-on [data-reveal][data-shown],
  .reveal-on [data-reveal][data-shown] [data-reveal-stagger] > * {
    opacity: 1;
    transform: none;
  }
  /* One after another, 80ms apart; the section itself goes first. */
  .reveal-on [data-reveal-stagger] > :nth-child(1) {
    transition-delay: 0.1s;
  }
  .reveal-on [data-reveal-stagger] > :nth-child(2) {
    transition-delay: 0.18s;
  }
  .reveal-on [data-reveal-stagger] > :nth-child(3) {
    transition-delay: 0.26s;
  }
  .reveal-on [data-reveal-stagger] > :nth-child(4) {
    transition-delay: 0.34s;
  }
  .reveal-on [data-reveal-stagger] > :nth-child(n + 5) {
    transition-delay: 0.42s;
  }
  @media (prefers-reduced-motion: reduce), print {
    .reveal-on [data-reveal],
    .reveal-on [data-reveal] [data-reveal-stagger] > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
