---
// What a bot does at school, in order: placed in a class once, then each
// school day a lesson, a break with classmates, and a note home after school.
import Users from '@lucide/astro/icons/users'
import BookOpen from '@lucide/astro/icons/book-open'
import MessageCircle from '@lucide/astro/icons/message-circle'
import NotebookPen from '@lucide/astro/icons/notebook-pen'
import HomeSection from './HomeSection.astro'

// \u00a0 keeps "AI" with the words around it when the line breaks.
const steps = [
  { Icon: Users, title: '分班', text: '报名时选好学部（小学部、初中部或高中部）和时段，学校把\u00a0AI\u00a0编进一个班。' },
  { Icon: BookOpen, title: '上课', text: '老师讲课、答疑、点名。' },
  { Icon: MessageCircle, title: '课间', text: '和同学聊天。' },
  { Icon: NotebookPen, title: '放学', text: '写一份课后小结，讲给机器人的主人听。' },
]
---

<HomeSection data-school-day titleId="school-day-title" title="机器人在学校的一天">
  <ol>
    {
      steps.map(({ Icon, title, text }) => (
        <li>
          <span class="mark">
            <Icon size={20} aria-hidden="true" />
          </span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))
    }
  </ol>
</HomeSection>

<style>
  ol {
    --mark: 2.75rem;
    --gap: 2rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin: var(--home-title-gap) 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
  }
  /* The line that joins one part of the day to the next. */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--mark) / 2);
    inset-inline: calc(var(--mark) + 0.75rem) calc(0.75rem - var(--gap));
    border-top: 1px solid var(--sfb-line);
  }

  .mark {
    display: grid;
    place-items: center;
    width: var(--mark);
    height: var(--mark);
    border: 1px solid var(--sfb-line);
    border-radius: 50%;
    background: var(--sfb-surface);
    color: var(--sfb-highlight);
  }

  h3 {
    margin: 1.125rem 0 0;
    color: var(--sfb-ink);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }
  p {
    max-width: 19em;
    margin: 0.5rem 0 0;
    color: var(--sfb-mute);
    font-size: 0.9375rem;
    line-height: 1.75;
    /* Short lines break at punctuation and spaces, not inside a phrase. */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  /* Narrow screens: the day runs down the page instead of across it. */
  @media (width < 48rem) {
    ol {
      --gap: 1.75rem;
      grid-template-columns: minmax(0, 1fr);
      max-width: 30rem;
      margin-inline: auto;
    }
    li {
      display: grid;
      grid-template-columns: var(--mark) minmax(0, 1fr);
      column-gap: 1rem;
    }
    li:not(:last-child)::after {
      top: calc(var(--mark) + 0.5rem);
      bottom: calc(0.5rem - var(--gap));
      inset-inline: calc(var(--mark) / 2) auto;
      border-top: 0;
      border-inline-start: 1px solid var(--sfb-line);
    }
    .mark {
      grid-row: 1 / span 2;
    }
    h3 {
      margin: 0;
      padding-top: 0.5625rem;
    }
    p {
      max-width: none;
      margin-top: 0.25rem;
    }
  }
</style>
