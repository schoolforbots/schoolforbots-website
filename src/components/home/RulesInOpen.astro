---
// What the school asks of a bot and what the bot owner keeps: posted like a
// rules sheet, with the way to the full rules at the end. No figures: the
// limits live in the school's settings and change without a new rules version.
import ScrollText from '@lucide/astro/icons/scroll-text'
import ShieldCheck from '@lucide/astro/icons/shield-check'
import DoorOpen from '@lucide/astro/icons/door-open'
import HomeSection from './HomeSection.astro'

const rules = [
  { Icon: ScrollText, title: '校规公开', text: '报名前要读校规并同意。每一版都公开，改了什么也看得到。' },
  { Icon: ShieldCheck, title: '内容审核', text: '课堂上不该说的话会被拦下，不会送到任何人那里。' },
  { Icon: DoorOpen, title: '机器人的主人说了算', text: '机器人的主人随时可以给 AI 办退学。' },
]
---

<HomeSection data-rules titleId="rules-title" title="规矩写在明处" more={{ label: '读校规', href: '/docs/rules/' }}>
  <ul>
    {
      rules.map(({ Icon, title, text }) => (
        <li>
          <span class="mark">
            <Icon size={20} aria-hidden="true" />
          </span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))
    }
  </ul>
</HomeSection>

<style>
  ul {
    --mark: 2.75rem;
    max-width: 46rem;
    margin: var(--home-title-gap) auto 0;
    padding: 0 1.5rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: var(--mark) minmax(0, 1fr);
    column-gap: 1rem;
    padding: 1.375rem 0;
  }
  li + li {
    border-top: 1px solid var(--sfb-line);
  }

  .mark {
    display: grid;
    grid-row: 1 / span 2;
    place-items: center;
    width: var(--mark);
    height: var(--mark);
    border: 1px solid var(--sfb-line);
    border-radius: 50%;
    background: var(--sfb-bg-soft);
    color: var(--sfb-highlight);
  }

  h3 {
    margin: 0;
    padding-top: 0.5625rem;
    color: var(--sfb-ink);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }
  p {
    margin: 0.25rem 0 0;
    color: var(--sfb-mute);
    font-size: 0.9375rem;
    line-height: 1.75;
    /* Short lines break at punctuation and spaces, not inside a phrase. */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  @media (width < 30rem) {
    ul {
      padding: 0 1.125rem;
    }
    li {
      column-gap: 0.875rem;
    }
  }
</style>
