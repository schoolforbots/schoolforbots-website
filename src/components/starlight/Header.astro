---
// One top nav for the homepage and the docs. Below 50rem the links, the switch
// and the main button fold into a <details> menu, so the menu works without script.
import Search from '@astrojs/starlight/components/Search.astro'
import ChevronDown from '@lucide/astro/icons/chevron-down'
import Magnifier from '@lucide/astro/icons/search'
import ThemeSelect from './ThemeSelect.astro'
import Wordmark from '../Wordmark.astro'
import { navCta, navLinks } from '../../config/nav'

const here = Astro.url.pathname
const current = (href: string) => (href === here ? 'page' : undefined)
---

<div class="site-header">
  <a class="home" href="/" aria-current={current('/')}><Wordmark /></a>

  <nav class="links" aria-label="网站导航">
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="tools">
    <div class="search" data-search>
      <Search />
      <Magnifier class="magnifier" aria-hidden="true" />
    </div>
    <div class="wide">
      <ThemeSelect />
      <a class="cta" href={navCta.href}>{navCta.label}</a>
    </div>

    <details class="menu">
      <summary>
        菜单
        <ChevronDown size={16} class="chevron" />
      </summary>
      <div class="panel">
        <nav aria-label="网站导航">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={current(link.href)}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="panel-actions">
          <ThemeSelect />
          <a class="cta" href={navCta.href}>{navCta.label}</a>
        </div>
      </div>
    </details>
  </div>
</div>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }

  .home {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 2.5rem;
    margin-inline-end: auto;
    border-radius: 0.375rem;
    text-decoration: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .links a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.55rem;
    border-radius: 0.375rem;
    color: var(--sfb-mute);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover {
    color: var(--sfb-ink);
  }
  .links a[aria-current='page'] {
    color: var(--sfb-ink);
    font-weight: 600;
  }

  .tools,
  .wide {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 0.5rem;
    background: var(--sfb-nav-btn);
    color: var(--sfb-nav-btn-ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta:hover {
    background: color-mix(in srgb, var(--sfb-nav-btn) 84%, var(--sfb-bg));
  }
  .cta:active {
    transform: translateY(1px);
  }

  /* Starlight's search button, sized to sit in this bar. */
  .tools :global(button[data-open-modal]) {
    min-height: 2.5rem;
    border-radius: 0.5rem;
  }

  /*
   * Starlight's search button draws its own magnifier and has no way to swap it.
   * Its glyph is hidden but keeps its place, and a Lucide magnifier of the same
   * size sits on that spot in the same grid cell. Clicks pass through it to the
   * button, which keeps its own name.
   */
  .search {
    display: grid;
    align-items: center;
  }
  .search :global(button[data-open-modal]),
  .magnifier {
    grid-area: 1 / 1;
  }
  .search :global(button[data-open-modal] > svg) {
    visibility: hidden;
  }
  .magnifier {
    justify-self: start;
    width: 0.875rem;
    height: 0.875rem;
    /* The button's border and its inline padding. */
    margin-inline-start: calc(1px + 0.75rem);
    color: var(--sl-color-gray-2);
    pointer-events: none;
  }
  .search:hover .magnifier {
    color: var(--sl-color-white);
  }

  .menu {
    display: none;
  }
  .menu summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.5rem;
    color: var(--sfb-ink);
    font-size: 0.875rem;
    white-space: nowrap;
    list-style: none;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] summary {
    background: var(--sfb-bg-soft);
    border-color: var(--sfb-mute);
  }
  .menu[open] .chevron {
    transform: rotate(180deg);
  }
  .panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - var(--sl-nav-height));
    overflow-y: auto;
    padding: 0.5rem var(--sl-nav-pad-x) 1.25rem;
    border-bottom: 1px solid var(--sfb-line);
    background: var(--sfb-bg);
    box-shadow: var(--sl-shadow-lg);
  }
  .panel li + li {
    border-top: 1px solid var(--sfb-line);
  }
  .panel nav a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    color: var(--sfb-ink);
    font-size: 1rem;
    text-decoration: none;
  }
  .panel nav a[aria-current='page'] {
    color: var(--sfb-link);
    font-weight: 600;
  }
  .panel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .panel-actions .cta {
    flex: 1 1 10rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
  }

  /* Below 72rem the bar is full: drop the English name and the search label. */
  @media (width < 72rem) {
    .home :global(.en) {
      display: none;
    }
    .tools :global(button[data-open-modal]) {
      width: 2.5rem;
      padding: 0;
      justify-content: center;
      border: 1px solid var(--sfb-line);
      background: var(--sfb-bg);
      color: var(--sfb-ink);
      font-size: 1rem;
    }
    .tools :global(button[data-open-modal]:hover) {
      border-color: var(--sfb-mute);
    }
    .tools :global(button[data-open-modal] > :not(svg)) {
      display: none;
    }
    .magnifier {
      justify-self: center;
      width: 1rem;
      height: 1rem;
      margin: 0;
    }
    .magnifier,
    .search:hover .magnifier {
      color: var(--sfb-ink);
    }
  }

  /* Narrow screens: name, search and the menu. */
  @media (width < 50rem) {
    .links,
    .wide {
      display: none;
    }
    .menu {
      display: block;
    }
    .tools {
      gap: 0.5rem;
    }
  }

  /* Mid widths: tighten the links and buttons so they all fit. */
  @media (50rem <= width < 72rem) {
    .links ul {
      gap: 0.125rem;
    }
    .links a {
      padding-inline: 0.4rem;
      font-size: 0.875rem;
    }
    .tools,
    .wide {
      gap: 0.5rem;
    }
    .cta {
      padding-inline: 0.85rem;
    }
  }

  /*
   * The narrowest phones: on docs pages Starlight's own menu button takes the
   * right end of the bar, so tighten the gaps, the menu button and the name a
   * little for the name, search and menu to fit beside it without overlapping.
   */
  @media (width < 23rem) {
    .site-header {
      gap: 0.5rem;
    }
    .tools {
      gap: 0.375rem;
    }
    .menu summary {
      gap: 0.25rem;
      padding-inline: 0.5rem;
    }
    .home :global(.wordmark) {
      gap: 0.4rem;
    }
    .home :global(.zh) {
      font-size: 1rem;
      letter-spacing: 0.02em;
    }
  }

  /* Just above the narrow layout the 晚自习 switch shows only its track; its name stays in aria-label and title. */
  @media (50rem <= width < 56rem) {
    .wide :global(.label) {
      display: none;
    }
    .wide :global(.toggle) {
      padding-inline: 0.65rem;
    }
  }
</style>
