---
// The previous and next links at the foot of a docs page: two quiet cards, a
// small 上一篇 or 下一篇 over the page title and a round arrow that nudges the
// way it leads on hover. A lone 下一篇 keeps to the right-hand column. Lucide
// arrows, so the site keeps one icon set.
import type {} from '@astrojs/starlight' // Starlight's types for Astro.locals
import ArrowLeft from '@lucide/astro/icons/arrow-left'
import ArrowRight from '@lucide/astro/icons/arrow-right'

const { dir, pagination } = Astro.locals.starlightRoute
const { prev, next } = pagination
const isRtl = dir === 'rtl'
const PrevArrow = isRtl ? ArrowRight : ArrowLeft
const NextArrow = isRtl ? ArrowLeft : ArrowRight
---

<nav class="pagination-links print:hidden" dir={dir} aria-label="翻页">
  {
    prev && (
      <a class="card prev lift" href={prev.href} rel="prev">
        <span class="mark">
          <PrevArrow size={18} aria-hidden="true" />
        </span>
        <span class="text">
          <span class="kind">{Astro.locals.t('page.previousLink')}</span>
          <span class="link-title">{prev.label}</span>
        </span>
      </a>
    )
  }
  {
    next && (
      <a class="card next lift" href={next.href} rel="next">
        <span class="text">
          <span class="kind">{Astro.locals.t('page.nextLink')}</span>
          <span class="link-title">{next.label}</span>
        </span>
        <span class="mark">
          <NextArrow size={18} aria-hidden="true" />
        </span>
      </a>
    )
  }
</nav>

<style>
  .pagination-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 4.5rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
    color: var(--sfb-ink);
    text-decoration: none;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--sfb-mute) 45%, var(--sfb-line));
  }
  .next {
    grid-column: 2;
    justify-content: flex-end;
    text-align: end;
  }
  .text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .kind {
    color: var(--sfb-mute);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .link-title {
    color: var(--sfb-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition: color 0.2s ease-out;
  }
  .card:hover .link-title {
    color: var(--sfb-link);
  }
  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sfb-line);
    border-radius: 50%;
    background: var(--sfb-bg-soft);
    color: var(--sfb-highlight);
    transition: transform 0.2s ease-out;
  }
  .prev:hover .mark {
    transform: translateX(-3px);
  }
  .next:hover .mark {
    transform: translateX(3px);
  }
  :global([dir='rtl']) .prev:hover .mark {
    transform: translateX(3px);
  }
  :global([dir='rtl']) .next:hover .mark {
    transform: translateX(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .link-title,
    .mark {
      transition: none;
    }
    .card:hover .mark {
      transform: none;
    }
  }

  /* Narrow screens: one card per row, a lone 下一篇 included. */
  @media (width < 36rem) {
    .pagination-links {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
    .next {
      grid-column: auto;
    }
  }
</style>
