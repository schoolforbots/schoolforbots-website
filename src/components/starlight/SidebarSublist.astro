---
// One level of the docs sidebar: links, and groups that open and close. It
// follows Starlight's own SidebarSublist, with three changes: the group chevron
// is a Lucide icon, a group eases open and shut (lib/disclosure.ts) while its
// chevron turns, and the current page's wash is a block of its own that slides
// between links when the page changes.
import type {} from '@astrojs/starlight' // Starlight's types for Astro.locals
import type { StarlightRouteData } from '@astrojs/starlight/route-data'
import { Badge } from '@astrojs/starlight/components'
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro'
import ChevronRight from '@lucide/astro/icons/chevron-right'

type Entry = StarlightRouteData['sidebar'][number]
type Group = Extract<Entry, { type: 'group' }>

interface Props {
  sublist: Entry[]
  nested?: boolean
}

const { sublist, nested } = Astro.props

// A group holding the current page starts open.
const hasCurrent = (group: Group): boolean =>
  group.entries.some((entry) => (entry.type === 'link' ? entry.isCurrent : hasCurrent(entry)))
---

<ul class:list={{ 'top-level': !nested }}>
  {
    sublist.map((entry) => (
      <li>
        {entry.type === 'link' ? (
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? 'page' : undefined}
            class:list={[{ large: !nested }, entry.attrs.class]}
            {...entry.attrs}
          >
            {/* The current page's wash, a block of its own so it can slide to the next page's link when the page changes (the sidebar-current view transition in starlight.css). */}
            {entry.isCurrent && <span class="current-mark" aria-hidden="true" />}
            <span>{entry.label}</span>
            {entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
          </a>
        ) : (
          <details open={hasCurrent(entry) || !entry.collapsed} data-animate>
            <summary>
              <span class="group-label">
                <span class="large">{entry.label}</span>
                {entry.badge && (
                  <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />
                )}
              </span>
              <ChevronRight class="caret" size={18} aria-hidden="true" />
            </summary>
            <SidebarRestorePoint />
            <Astro.self sublist={entry.entries} nested />
          </details>
        )}
      </li>
    ))
  }
</ul>

<style>
  @layer starlight.core {
    ul {
      --sl-sidebar-item-padding-inline: 0.5rem;
      list-style: none;
      padding: 0;
    }

    li {
      overflow-wrap: anywhere;
    }

    ul ul li {
      margin-inline-start: var(--sl-sidebar-item-padding-inline);
      border-inline-start: 1px solid var(--sl-color-hairline-light);
      padding-inline-start: var(--sl-sidebar-item-padding-inline);
    }

    .large {
      font-size: var(--sl-text-lg);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .top-level > li + li {
      margin-top: 0.75rem;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.2em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
      cursor: pointer;
      user-select: none;
    }
    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .caret {
      flex-shrink: 0;
      transition: transform 0.3s cubic-bezier(0.33, 1, 0.68, 1);
    }
    @media (prefers-reduced-motion: reduce) {
      .caret {
        transition: none;
      }
    }
    :global([dir='rtl']) .caret {
      transform: rotateZ(180deg);
    }
    [open]:not([data-closing]) > summary .caret {
      transform: rotateZ(90deg);
    }

    a {
      display: block;
      border-radius: 0.25rem;
      text-decoration: none;
      color: var(--sl-color-gray-2);
      padding: 0.3em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
    }

    a:hover,
    a:focus {
      color: var(--sl-color-white);
    }

    [aria-current='page'],
    [aria-current='page']:hover,
    [aria-current='page']:focus {
      position: relative;
      isolation: isolate;
      font-weight: 600;
      color: var(--sfb-link);
    }
    .current-mark {
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background-color: var(--sl-color-accent-low);
      view-transition-name: sidebar-current;
    }

    a > *:not(:last-child),
    .group-label > *:not(:last-child) {
      margin-inline-end: 0.25em;
    }

    @media (min-width: 50rem) {
      .top-level > li + li {
        margin-top: 0.5rem;
      }
      .large {
        font-size: var(--sl-text-base);
      }
      a {
        font-size: var(--sl-text-sm);
      }
    }
  }
</style>
