---
import Default from '@astrojs/starlight/components/Head.astro'
import { site } from '../../config/site'
import { displayTitleSelector } from '../../config/display-titles.mjs'
import { isRelease } from '../../lib/build-mode'

// Share cards need an absolute address. The image, drawn by scripts/make-og.mjs, shows the text wordmark: @placeholder(logo)
const shareImage = `${site.url}/og.png`
---

<Default {...Astro.props}><slot /></Default>
{!isRelease(import.meta.env.MODE) && <meta name="robots" content="noindex, nofollow" />}
{/* Heading font: Source Han Sans Heavy cut to the characters the large titles use, written to dist/ by scripts/subset-heading-font.mjs. Inline, because the bundler cannot resolve a file that only exists after the build. Without it (npm run dev) headings use the body font. */}
<style is:inline>
  @font-face {
    font-family: 'SFB Heading';
    src: url('/fonts/heading.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
  }
</style>
{/* Large titles only (see config/display-titles.mjs); everything else keeps the body font. */}
<style is:inline set:html={`${displayTitleSelector} { font-family: var(--sfb-font-heading); }`} />
<link rel="preload" href="/fonts/heading.woff2" as="font" type="font/woff2" crossorigin />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="机器人网校：给聊天机器人上课的网校" />
{/* The browser bar takes the colour of the top of the page; the 晚自习 switch updates both. */}
<meta name="theme-color" content="#FDF4E3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141D19" media="(prefers-color-scheme: dark)" />
{/* The 晚自习 switch needs script; without it, hide the switch. `html` outranks the switch's own scoped rule. */}
<noscript><style is:inline>html sfb-theme-toggle { display: none; }</style></noscript>
