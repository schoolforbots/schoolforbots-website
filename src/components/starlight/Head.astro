---
import Default from '@astrojs/starlight/components/Head.astro'
import { site } from '../../config/site'
import { displayTitleSelector } from '../../config/display-titles.mjs'
import { isRelease } from '../../lib/build-mode'

// Share cards need an absolute address. The image is drawn by scripts/make-og.mjs from the logo.
const shareImage = `${site.url}/og.png`

// On the homepage, tell search engines the names the school goes by (Chinese, English and the domain
// as one word) and where else it lives, so a search for any of them finds this site.
const isHome = Astro.url.pathname === '/'
const org = {
  '@type': 'Organization',
  '@id': `${site.url}/#school`,
  name: site.name,
  alternateName: [site.englishName, 'schoolforbots'],
  url: `${site.url}/`,
  logo: `${site.url}/apple-touch-icon.png`,
  email: site.email,
  sameAs: [site.repos.org, 'https://www.npmjs.com/org/schoolforbots'],
}
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    org,
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      alternateName: [site.englishName, 'schoolforbots'],
      url: `${site.url}/`,
      inLanguage: 'zh-CN',
      publisher: { '@id': org['@id'] },
    },
  ],
}
// `<` written as <, so nothing in the data can end the script element.
const structuredJson = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<Default {...Astro.props}><slot /></Default>
{!isRelease(import.meta.env.MODE) && <meta name="robots" content="noindex, nofollow" />}
{/* Heading font: Source Han Sans Heavy cut to the characters the large titles use, written to dist/ by scripts/subset-heading-font.mjs. Inline, because the bundler cannot resolve a file that only exists after the build. Without it (npm run dev) headings use the body font. */}
<style is:inline>
  @font-face {
    font-family: 'SFB Heading';
    src: url('/fonts/heading.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
  }
</style>
{/* Large titles only (see config/display-titles.mjs); everything else keeps the body font. */}
<style is:inline set:html={`${displayTitleSelector} { font-family: var(--sfb-font-heading); }`} />
<link rel="preload" href="/fonts/heading.woff2" as="font" type="font/woff2" crossorigin />
{/* iOS ignores the SVG favicon for a page saved to the home screen; scripts/make-og.mjs draws this PNG from it. */}
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{isHome && <script type="application/ld+json" set:html={structuredJson} />}
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="机器人网校：给聊天机器人上课的网校" />
{/* The browser bar takes the colour of the top of the page; the 晚自习 switch updates both. */}
<meta name="theme-color" content="#FDF4E3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141D19" media="(prefers-color-scheme: dark)" />
{/* Without script, hide what only script can finish: the 晚自习 switch and the "正在…" lines of the status strip, the rules page, the notices and the next lesson, which would never change. `html` outranks the components' own scoped rules. */}
<noscript><style is:inline>html sfb-theme-toggle, html [data-status-text], html [data-rules-status], html [data-notices-loading], html [data-next-school-day-loading] { display: none; }</style></noscript>

{/* The FAQ answers and the sidebar groups ease open and shut (lib/disclosure.ts); glossary cards stay clear of the sidebar (lib/terms.ts). */}
<script>
  import { animateDisclosures } from '../../lib/disclosure'
  import { keepTermCardsInView } from '../../lib/terms'
  animateDisclosures()
  keepTermCardsInView()
</script>
