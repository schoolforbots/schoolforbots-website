---
// 晚自习: the dark-mode switch, in place of Starlight's theme menu. The choice is
// kept where Starlight keeps it, so Starlight's ThemeProvider applies it before
// the first paint on every page, and the switch draws itself from that
// `data-theme`, so it is right on first paint with no script of its own.
//
// The words say which theme is on: 白天 or 晚自习. The one not shown is
// `visibility: hidden`, out of the accessibility tree, so the button's name is
// the visible word plus what pressing it does.
---

<sfb-theme-toggle>
  <button type="button" class="toggle" title="切换白天和晚自习（深色模式）">
    <span class="track" aria-hidden="true"><span class="knob"></span></span>
    <span class="label">
      <span class="day">白天<span class="sr-only">，点按换成晚自习（深色模式）</span></span>
      <span class="night">晚自习<span class="sr-only">，点按换成白天</span></span>
    </span>
  </button>
</sfb-theme-toggle>

<script>
  type Theme = 'light' | 'dark'

  // Starlight's key: 'light', 'dark', or '' to follow the system.
  const storageKey = 'starlight-theme'
  // The browser bar takes the colour of the top of the page.
  const barColour: Record<Theme, string> = { light: '#FDF4E3', dark: '#141D19' }
  const system = matchMedia('(prefers-color-scheme: dark)')
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')

  function chosen(): Theme | null {
    try {
      const value = localStorage.getItem(storageKey)
      return value === 'light' || value === 'dark' ? value : null
    } catch {
      return null
    }
  }

  function choose(theme: Theme): void {
    try {
      localStorage.setItem(storageKey, theme)
    } catch {
      // Storage is off: the choice lasts until the page is left.
    }
  }

  // A choice paints both browser-bar colours; with none, each keeps the colour for its own system setting.
  function show(theme: Theme, isChoice: boolean): void {
    document.documentElement.dataset.theme = theme
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      const own: Theme = meta.getAttribute('media')?.includes('dark') ? 'dark' : 'light'
      meta.setAttribute('content', barColour[isChoice ? theme : own])
    })
  }

  function follow(): void {
    const choice = chosen()
    show(choice ?? (system.matches ? 'dark' : 'light'), choice !== null)
  }

  // Day turns to night (and back) as one cross-fade of the whole page, while the
  // pressed switch stays live above it so its knob is seen sliding across
  // (`sfb-theme-changing` in starlight.css). Without view transitions, or with
  // reduced motion, the theme changes at once and only the knob slides.
  function change(next: Theme, button: HTMLElement): void {
    const apply = () => {
      choose(next)
      show(next, true)
    }
    if (reduce.matches || typeof document.startViewTransition !== 'function') {
      apply()
      return
    }
    const root = document.documentElement
    root.classList.add('sfb-theme-changing')
    button.style.viewTransitionName = 'sfb-theme-toggle'
    const done = () => {
      root.classList.remove('sfb-theme-changing')
      button.style.viewTransitionName = ''
    }
    document.startViewTransition(apply).finished.then(done, done)
  }

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')
      button?.addEventListener('click', () => {
        change(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark', button)
      })
    }
  }
  customElements.define('sfb-theme-toggle', ThemeToggle)

  follow()
  // No choice made: keep following the system, live.
  system.addEventListener('change', () => {
    if (!chosen()) follow()
  })
  // A choice made in another tab, or a page restored from the back-forward cache.
  addEventListener('storage', (event) => {
    if (event.key === storageKey) follow()
  })
  addEventListener('pageshow', (event) => {
    if (event.persisted) follow()
  })
</script>

<style>
  sfb-theme-toggle {
    display: contents;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.5rem;
    padding: 0 0.8rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sfb-ink);
    font: inherit;
    font-size: 0.875rem;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .toggle:hover {
    background: var(--sfb-bg-soft);
    border-color: var(--sfb-mute);
  }
  .toggle:active {
    transform: translateY(1px);
  }
  .track {
    position: relative;
    flex: none;
    width: 30px;
    height: 18px;
    border-radius: 9px;
    background: var(--sfb-line);
    transition: background-color 0.28s ease;
  }
  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--sfb-mute);
    transition:
      transform 0.28s cubic-bezier(0.34, 1.4, 0.64, 1),
      background-color 0.28s ease;
  }
  /* Pressed, the knob stretches toward where it is going, as a finger drags it. */
  .toggle:active .knob {
    width: 15px;
  }
  :global([data-theme='dark']) .track {
    background: var(--sfb-btn);
  }
  :global([data-theme='dark']) .knob {
    transform: translateX(12px);
    background: var(--sfb-btn-ink);
  }
  :global([data-theme='dark']) .toggle:active .knob {
    transform: translateX(9px);
  }

  /* Both words in one cell, so the button keeps the width of the longer one and does not jump. */
  .label {
    display: inline-grid;
  }
  .day,
  .night {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s ease,
      visibility 0.2s;
  }
  .night,
  :global([data-theme='dark']) .day {
    visibility: hidden;
    opacity: 0;
  }
  :global([data-theme='dark']) .night {
    visibility: visible;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .knob,
    .day,
    .night {
      transition: none;
    }
  }
</style>
