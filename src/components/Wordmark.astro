---
// The school's logo and name. The logo is the same file as the favicon, so the browser fetches it once.
---

<span class="wordmark" translate="no">
  <img class="logo" src="/favicon.svg" alt="" width="24" height="24" />
  <span class="name">
    <span class="zh">机器人网校</span>
    <span class="en" lang="en">School for Bots</span>
  </span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--sfb-ink);
    white-space: nowrap;
  }
  .logo {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
  .name {
    display: flex;
    align-items: baseline;
    column-gap: 0.5rem;
  }
  .zh {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }
  .en {
    font-size: 0.8125rem;
    color: var(--sfb-mute);
    letter-spacing: 0.01em;
  }
</style>
