---
// The school's notices, newest first: all of them on the notices page, the
// latest few on the homepage. With none yet, a line says so.
import { getCollection } from 'astro:content'
import Megaphone from '@lucide/astro/icons/megaphone'
import { isNotice, latestNotices, noticeDate, noticeTime } from '../lib/notices'

interface Props {
  limit?: number
}

const { limit = Infinity } = Astro.props

const notices = latestNotices(await getCollection('docs', ({ id }) => isNotice(id)), limit).map((entry) => ({
  entry,
  date: noticeDate(entry.id),
  time: noticeTime(entry.id, entry.data.published),
}))

// "2026-12-01" as 2026年12月1日.
const longDate = (date: string) => {
  const [y, m, d] = date.split('-').map(Number)
  return `${y}年${m}月${d}日`
}
---

<div class="notices not-content" data-notice-list>
  {
    notices.length === 0 ? (
      <p class="empty">
        <Megaphone size={20} aria-hidden="true" />
        还没有公告。
      </p>
    ) : (
      <ul>
        {notices.map(({ entry, date, time }) => (
          <li>
            <a href={`/${entry.id}/`}>
              <time datetime={time ? entry.data.published!.toISOString() : date}>
                {longDate(date)}
                {time && <span class="clock">{time}</span>}
              </time>
              <span class="title">{entry.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .notices {
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
  }

  .empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 1.75rem 1.25rem;
    color: var(--sfb-mute);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .empty :global(svg) {
    flex: none;
    color: var(--sfb-highlight);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    border-top: 1px solid var(--sfb-line);
  }
  /* The whole row is the link. Under the pointer it darkens: a deeper fill, the title in the link colour. */
  a {
    display: grid;
    grid-template-columns: 12em minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
    padding: 1rem 1.25rem;
    color: var(--sfb-ink);
    line-height: 1.6;
    text-decoration: none;
    transition:
      background-color 0.2s ease-out,
      color 0.2s ease-out;
  }
  li:first-child a {
    border-radius: 0.875rem 0.875rem 0 0;
  }
  li:last-child a {
    border-radius: 0 0 0.875rem 0.875rem;
  }
  li:only-child a {
    border-radius: 0.875rem;
  }
  a:hover {
    background: var(--sfb-bg-soft);
  }
  a:hover .title {
    color: var(--sfb-link);
  }
  a:focus-visible {
    outline-offset: -2px;
  }
  time {
    color: var(--sfb-mute);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .clock {
    margin-inline-start: 0.5em;
  }
  .title {
    font-weight: 600;
    transition: color 0.2s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    a,
    .title {
      transition: none;
    }
  }

  /* Phones: the date sits above the title. */
  @media (width < 30rem) {
    a {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }
  }
</style>
