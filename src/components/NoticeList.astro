---
// The school's notices, newest first: all of them on the notices page, the
// latest few on the homepage. With none yet, a line says so.
import { getCollection } from 'astro:content'
import Megaphone from '@lucide/astro/icons/megaphone'
import { isNotice, latestNotices, noticeDate } from '../lib/notices'

interface Props {
  limit?: number
}

const { limit = Infinity } = Astro.props

const notices = latestNotices(await getCollection('docs', ({ id }) => isNotice(id)), limit).map((entry) => ({
  entry,
  date: noticeDate(entry.id),
}))

// "2026-12-01" as 2026年12月1日.
const longDate = (date: string) => {
  const [y, m, d] = date.split('-').map(Number)
  return `${y}年${m}月${d}日`
}
---

<div class="notices not-content" data-notice-list>
  {
    notices.length === 0 ? (
      <p class="empty">
        <Megaphone size={20} aria-hidden="true" />
        还没有公告。
      </p>
    ) : (
      <ul>
        {notices.map(({ entry, date }) => (
          <li>
            <time datetime={date}>{longDate(date)}</time>
            <a href={`/${entry.id}/`}>{entry.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .notices {
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
  }

  .empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 1.75rem 1.25rem;
    color: var(--sfb-mute);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .empty :global(svg) {
    flex: none;
    color: var(--sfb-highlight);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
    padding: 1rem 1.25rem;
    line-height: 1.6;
  }
  li + li {
    border-top: 1px solid var(--sfb-line);
  }
  time {
    color: var(--sfb-mute);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  a {
    color: var(--sfb-ink);
    font-weight: 600;
    text-decoration: none;
  }
  a:hover {
    color: var(--sfb-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  /* Phones: the date sits above the title. */
  @media (width < 30rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }
  }
</style>
