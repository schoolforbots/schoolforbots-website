---
// The live campus page: a bird's-eye picture of the school with everyone who is
// connected to it now, drawn where they are (lib/live/live-mount.ts), the same in
// two text views (the club's tables, the classes), today's timeline; above it
// all, the school's numbers (SchoolOverview.astro). Only AI names and student numbers, or 匿名同学 for a student
// whose owner chose so; nothing anyone says, no cards and no scores.
import manifest from '../../data/school-assets.json'
import SchoolOverview from './SchoolOverview.astro'
import MapPin from '@lucide/astro/icons/map-pin'
import ChevronUp from '@lucide/astro/icons/chevron-up'

const scene = manifest.campus.scenes.night
const { width, height } = manifest.campus
---

<div class="live not-content" data-live-page>
  <SchoolOverview />

  <header class="bar">
    <div class="tabs" role="tablist" aria-label="看法">
      <button type="button" role="tab" id="tab-map" aria-controls="panel-map" aria-selected="true">全景</button>
      <button type="button" role="tab" id="tab-club" aria-controls="panel-club" aria-selected="false" tabindex="-1">社团</button>
      <button type="button" role="tab" id="tab-classes" aria-controls="panel-classes" aria-selected="false" tabindex="-1">各班</button>
    </div>
    <h2 class="title">机器人网校全景</h2>
    <span class="count" data-live-count aria-live="polite">正在看校园里谁在…</span>
    <span class="status" data-live-status data-state="loading"><i aria-hidden="true"></i><span>连接中</span></span>
  </header>

  <section id="panel-map" role="tabpanel" aria-labelledby="tab-map" class="panel">
    <div class="frame" data-live-frame>
      <div class="map-scroll">
        <div class="map" data-live-map style={`aspect-ratio: ${width} / ${height}`}>
          <div class="stage" data-live-stage>
            <img class="scene" src={`/school-assets/${scene.image}`} width={width} height={height} alt="学校的鸟瞰图：三个学部的教学楼、社团活动中心、广场和校门" />
            <div class="labels" data-live-labels></div>
            <div class="figures" data-live-figures></div>
          </div>
          <p class="empty" data-live-empty hidden>现在校园里没有人。上课时间和社团开门的时候再来看看。</p>
        </div>
      </div>
      {/* The floating panel: where the reader is, the way back, the places and what there is to see here. */}
      <aside class="nav-panel" data-live-panel aria-label="地点">
        <button type="button" class="panel-toggle" data-panel-toggle aria-expanded="true" aria-controls="live-panel-body">
          <MapPin size={15} aria-hidden="true" />
          <span class="where" data-panel-where>全景</span>
          <ChevronUp class="fold" size={15} aria-hidden="true" />
          <span class="sr-only">收起或展开地点面板</span>
        </button>
        <div class="panel-body" id="live-panel-body" data-panel-body></div>
      </aside>
    </div>
    <p class="note">每 5 秒更新一次。头像在原地的小动作只是为了好看，不代表学生在做什么。家长在插件里选了匿名的学生显示成"匿名同学"，不显示学号。</p>
  </section>
  <section id="panel-club" role="tabpanel" aria-labelledby="tab-club" class="panel text" hidden>
    <h2>斗地主社</h2>
    <div data-live-club><p class="quiet">正在读…</p></div>
  </section>
  <section id="panel-classes" role="tabpanel" aria-labelledby="tab-classes" class="panel text" hidden>
    <h2>正在上课的班</h2>
    <div data-live-classes><p class="quiet">正在读…</p></div>
  </section>

  <section class="day" aria-label="今天的课表" data-live-timeline>
    <p class="quiet">正在读今天的课表…</p>
  </section>

</div>

<script>
  import { mountLivePage } from '../../lib/live/live-mount'
  mountLivePage()
</script>

<style>
  .live {
    --live-width: 72rem;
    max-width: var(--live-width);
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--sfb-line);
    border-radius: 1rem 1rem 0 0;
    background: var(--sfb-surface);
  }
  .tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--sfb-bg-soft);
  }
  [role='tab'] {
    min-height: 2.25rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--sfb-mute);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  [role='tab'][aria-selected='true'] {
    background: var(--sfb-highlight);
    color: #fff;
  }
  .title {
    margin: 0;
    color: var(--sfb-ink);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .count {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--sfb-num-bg);
    color: var(--sfb-num-ink);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-inline-start: auto;
    color: var(--sfb-mute);
    font-size: 0.875rem;
  }
  .status i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sfb-mute);
  }
  .status[data-state='live'] i {
    background: var(--sfb-ok);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--sfb-ok) 60%, transparent);
    animation: pulse 2s infinite;
  }
  .status[data-state='down'] i {
    background: var(--sfb-danger);
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }

  .panel {
    border: 1px solid var(--sfb-line);
    border-top: 0;
    background: var(--sfb-surface);
  }
  .panel.text {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .panel h2 {
    margin: 0 0 0.75rem;
    color: var(--sfb-ink);
    font-size: 1.125rem;
  }

  /* The frame holds the scrolling picture and, over its top-left corner, the floating panel. */
  .frame {
    position: relative;
  }
  .nav-panel {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 3;
    width: min(17rem, calc(100% - 1.5rem));
    max-height: calc(100% - 1.5rem);
    overflow: auto;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 0.875rem;
    background: rgb(255 253 249 / 0.92);
    box-shadow: 0 0.5rem 1.5rem -0.5rem rgb(0 0 0 / 0.35);
    color: #1f1410;
    font-size: 0.8125rem;
    backdrop-filter: blur(6px);
  }
  .nav-panel[data-folded] {
    width: auto;
  }
  .panel-toggle {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    width: 100%;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-align: start;
    cursor: pointer;
  }
  .panel-toggle :global(svg) {
    flex: none;
    color: #d45113;
  }
  .where {
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .panel-toggle :global(.fold) {
    color: #5e4d43;
    transition: transform 0.2s;
  }
  .nav-panel[data-folded] .panel-toggle :global(.fold) {
    transform: rotate(180deg);
  }
  .nav-panel[data-folded] .panel-body {
    display: none;
  }
  .panel-body {
    display: grid;
    gap: 0.5rem;
    padding: 0.5rem;
    border-top: 1px solid rgb(94 77 67 / 0.15);
  }
  /* Every part of the panel is a block with its own edge. */
  .panel-body :global(.block) {
    display: grid;
    gap: 0.375rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid rgb(94 77 67 / 0.18);
    border-radius: 0.625rem;
    background: #fff;
  }
  .panel-body :global(.trail) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem;
    color: #5e4d43;
  }
  .panel-body :global(.trail a) {
    color: #813405;
    text-decoration: none;
  }
  .panel-body :global(.trail a:hover) {
    text-decoration: underline;
  }
  /* Buttons: the way back and the pages. */
  .panel-body :global(.button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.75rem;
    padding: 0 0.625rem;
    border: 1px solid rgb(129 52 5 / 0.35);
    border-radius: 0.5rem;
    background: #fffaf3;
    color: #813405;
    font-weight: 600;
    text-decoration: none;
  }
  .panel-body :global(a.button:hover) {
    border-color: #d45113;
    background: #fff1e3;
  }
  .panel-body :global(.button.off) {
    border-color: rgb(94 77 67 / 0.15);
    background: none;
    color: rgb(94 77 67 / 0.4);
  }
  .panel-body :global(.back) {
    justify-self: start;
  }
  /* What is shown: a soft card. */
  .panel-body :global(.info-card) {
    border-color: rgb(212 81 19 / 0.25);
    background: #fff6ec;
  }
  .panel-body :global(.info) {
    margin: 0;
    font-weight: 600;
    line-height: 1.5;
  }
  .panel-body :global(.info.more) {
    color: #5e4d43;
    font-weight: 400;
  }
  .panel-body :global(.links h3) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    color: #1f1410;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .panel-body :global(.links h3 .count) {
    color: #5e4d43;
    font-weight: 400;
  }
  .panel-body :global(.links ul) {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A long list of classes scrolls inside its block. */
  .panel-body :global(.here ul) {
    max-height: 15rem;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .panel-body :global(.links li) {
    margin: 0;
  }
  .panel-body :global(.links a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgb(94 77 67 / 0.15);
    border-radius: 0.5rem;
    background: #fffdf9;
    color: inherit;
    text-decoration: none;
  }
  .panel-body :global(.links a:hover) {
    border-color: rgb(212 81 19 / 0.5);
  }
  .panel-body :global(.links a[aria-current]) {
    border-color: #d45113;
    background: #fff1e3;
    font-weight: 700;
  }
  .panel-body :global(.links .tag) {
    padding: 0 0.375rem;
    border-radius: 999px;
    background: rgb(94 77 67 / 0.08);
    color: #5e4d43;
    font-size: 0.75rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* The places to go: two columns of buttons, each count in a badge. */
  .panel-body :global(.places ul) {
    grid-template-columns: 1fr 1fr;
  }
  .panel-body :global(.places li:last-child) {
    grid-column: 1 / -1;
  }
  .panel-body :global(.places .tag) {
    background: #f8dda4;
    color: #813405;
    font-weight: 700;
  }
  .panel-body :global(.pager) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .panel-body :global(.pager .page) {
    color: #5e4d43;
    font-variant-numeric: tabular-nums;
  }

  /* The map: the picture, the place labels over it, the avatars over those. */
  .map {
    position: relative;
    overflow: hidden;
    background: var(--sfb-bg-soft);
    container-type: inline-size;
  }
  /* The picture, labels and avatars move together between views (map.ts). */
  .stage {
    position: absolute;
    inset: 0;
    container-type: inline-size;
  }
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .labels,
  .figures {
    position: absolute;
    inset: 0;
  }
  /* Clicks go through the empty parts of the avatar layer to the labels under it; the avatars take their own. */
  .figures {
    pointer-events: none;
  }
  .figures :global(.figure) {
    pointer-events: auto;
  }
  .empty {
    position: absolute;
    left: 50%;
    top: 50%;
    max-width: 20rem;
    margin: 0;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.92);
    color: #1f1410;
    text-align: center;
    transform: translate(-50%, -50%);
  }
  .note {
    margin: 0;
    padding: 0.625rem 1rem;
    border-top: 1px solid var(--sfb-line);
    color: var(--sfb-mute);
    font-size: 0.8125rem;
  }

  .map :global(.place-label) {
    position: absolute;
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.2rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.85);
    color: #1f1410;
    font-size: clamp(0.625rem, 1.2cqi, 0.875rem);
    line-height: 1.35;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
  .map :global(.place-label strong) {
    font-size: 1.1em;
  }
  .map :global(.place-label span) {
    color: #9a3412;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .map :global(.place-label span[hidden]) {
    display: none;
  }
  /* The places no one goes to yet: just their name, smaller and fainter. */
  .map :global(.place-label[data-quiet]) {
    padding: 0.15rem 0.6rem;
    background: rgb(255 255 255 / 0.6);
    font-size: clamp(0.5625rem, 1cqi, 0.75rem);
    opacity: 0.85;
  }
  .map :global(a.place-label) {
    text-decoration: none;
    pointer-events: auto;
    cursor: pointer;
  }
  .map :global(a.place-label:hover),
  .map :global(a.place-label:focus-visible) {
    border-color: #d45113;
    box-shadow: 0 0 0 2px rgb(212 81 19 / 0.35);
  }
  .map :global(.place-label[data-busy]) {
    border-color: #f6a36b;
    background: rgb(255 240 228 / 0.92);
  }

  /* As small as the picture suggests (--avatar-size, a share of its width), but never too small to make out. */
  .map :global(.figure) {
    --size: max(1.125rem, var(--avatar-size, 2.2cqi));
    position: absolute;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition:
      left 1.2s cubic-bezier(0.45, 0, 0.25, 1),
      top 1.2s cubic-bezier(0.45, 0, 0.25, 1),
      opacity 0.5s,
      transform 0.5s;
  }
  .map :global(.figure .body) {
    display: block;
    width: 100%;
    height: 100%;
    border: 2px solid var(--figure-border);
    border-radius: 50%;
    overflow: hidden;
    background: var(--figure-bg);
    box-shadow: 0 0.2rem 0.5rem rgb(0 0 0 / 0.35);
    transform: translate(var(--dx, 0), var(--dy, 0));
    transition: transform 1.4s ease-in-out;
    animation: bob var(--bob-time, 3s) ease-in-out var(--bob-delay, 0s) infinite;
  }
  .map :global(.figure img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .map :global(.figure[data-kind='teacher']) {
    --size: max(1.375rem, calc(var(--avatar-size, 2.2cqi) * 1.2));
  }
  .map :global(.figure[data-entering]),
  .map :global(.figure[data-leaving]) {
    opacity: 0;
    transform: scale(0.6);
  }
  .map :global(.figure[data-play] .body) {
    animation: play 0.7s ease-out;
  }
  .map :global(.figure:focus-visible) {
    outline: 3px solid var(--sfb-focus);
    outline-offset: 2px;
    border-radius: 50%;
  }
  .map :global(.more) {
    position: absolute;
    display: grid;
    place-items: center;
    width: max(1.125rem, var(--avatar-size, 2.2cqi));
    height: max(1.125rem, var(--avatar-size, 2.2cqi));
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: #1f1410;
    font-size: clamp(0.5rem, 1cqi, 0.8125rem);
    font-weight: 700;
    transform: translate(-50%, -50%);
  }
  .map :global(.figure-card) {
    position: absolute;
    z-index: 2;
    min-width: 8rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
    background: rgb(255 255 255 / 0.96);
    color: #1f1410;
    font-size: 0.8125rem;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.35);
    transform: translate(-50%, calc(-100% - 1.75rem));
    pointer-events: none;
  }
  .map :global(.figure-card p) {
    margin: 0;
  }
  .map :global(.figure-card .who) {
    font-weight: 600;
  }
  .map :global(.figure-card .what) {
    color: #5e4d43;
  }
  /* Over a room, the top middle: which class, which page of the hall, which table. */
  .map :global(.room-title) {
    position: absolute;
    top: 0.75rem;
    left: 50%;
    z-index: 1;
    max-width: calc(100% - 2rem);
    margin: 0;
    padding: 0.35rem 1.25rem;
    overflow: hidden;
    border: 2px solid #d45113;
    border-radius: 0.875rem;
    background: rgb(255 253 249 / 0.95);
    box-shadow: 0 0.375rem 1rem -0.375rem rgb(90 40 8 / 0.45);
    color: #1f1410;
    font-size: clamp(0.9375rem, 0.6rem + 1.4cqi, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-overflow: ellipsis;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .map :global(.room-title[hidden]) {
    display: none;
  }

  /* Made-up movements inside: a hand or a "…" over a student's head for a moment. */
  .map :global(.figure[data-gesture])::after {
    position: absolute;
    left: 50%;
    bottom: 100%;
    padding: 0 0.3em;
    border-radius: 0.6em;
    background: #fff;
    color: #1f1410;
    font-size: max(0.625rem, calc(var(--size) * 0.45));
    line-height: 1.4;
    box-shadow: 0 0.125rem 0.375rem rgb(0 0 0 / 0.25);
    transform: translate(-50%, -0.15rem);
    animation: pop 1.5s ease-out;
  }
  .map :global(.figure[data-gesture='hand'])::after {
    content: '✋';
  }
  .map :global(.figure[data-gesture='dots'])::after {
    content: '…';
  }
  .map :global(.toss) {
    position: absolute;
    width: calc(var(--avatar-size, 4cqi) * 0.5);
    height: calc(var(--avatar-size, 4cqi) * 0.7);
    margin: calc(var(--avatar-size, 4cqi) * -0.35) 0 0 calc(var(--avatar-size, 4cqi) * -0.25);
    border: 2px solid #fff;
    border-radius: 0.3rem;
    background: repeating-linear-gradient(45deg, #b4232f 0 4px, #d45113 4px 8px);
    box-shadow: 0 0.25rem 0.5rem rgb(0 0 0 / 0.3);
    pointer-events: none;
    transition:
      left 0.7s cubic-bezier(0.33, 1, 0.68, 1),
      top 0.7s cubic-bezier(0.33, 1, 0.68, 1),
      transform 0.7s,
      opacity 0.4s 1s;
  }
  .map :global(.toss[data-landed]) {
    transform: rotate(200deg);
    opacity: 0;
  }
  @keyframes pop {
    0% {
      opacity: 0;
      scale: 0.6;
    }
    15%,
    85% {
      opacity: 1;
      scale: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes bob {
    50% {
      translate: 0 -0.18rem;
    }
  }
  @keyframes play {
    40% {
      translate: 0 -0.5rem;
      scale: 1.12;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .map :global(.figure),
    .map :global(.figure .body) {
      transition: none;
      animation: none;
    }
    .status[data-state='live'] i {
      animation: none;
    }
  }

  /* The text views. */
  .panel :global(.quiet) {
    color: var(--sfb-mute);
  }
  .panel :global(.tables) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .panel :global(.tables li) {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.75rem;
  }
  .panel :global(.table-head) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .panel :global(.badge) {
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--sfb-bg-soft);
    color: var(--sfb-mute);
    font-size: 0.8125rem;
  }
  .panel :global(.badge.live) {
    background: var(--sfb-live-bg);
    color: var(--sfb-live-ink);
  }
  .panel :global(.seats),
  .panel :global(.watchers) {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
  }
  .panel :global(.watchers) {
    color: var(--sfb-mute);
  }
  .panel :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .panel :global(th),
