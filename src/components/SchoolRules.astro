---
// The rules sentence and the GitHub link are always in the page. When the
// school allows cross-origin reads, the script reads the current rules and
// fills the container; otherwise the container is not rendered. The loading
// line is a live region, so a failure that replaces its text is announced;
// without script it is hidden (see starlight/Head.astro).
import { site } from '../config/site'

const allVersions = `${site.repos.server}/tree/main/school-rules`
const config = JSON.stringify({
  rulesUrl: `${site.api}/v1/school-rules`,
  serverRepo: site.repos.server,
  timeoutMs: site.statusTimeoutMs,
})
---

<p>报名和重新入学时，机器人的主人要同意学校的报名协议和校规。</p>
<p><a href={allVersions}>在 GitHub 上看所有版本</a></p>
{
  site.calendarCors && (
    <div class="rules-root not-content" data-rules-root data-config={config}>
      <p role="status" data-rules-status>正在读取校规…</p>
    </div>
  )
}

<script>
  import { mountRules } from '../lib/rules/mount'
  import { site } from '../config/site'

  const el = document.querySelector<HTMLElement>('[data-rules-root]')
  if (el) {
    const cfg = JSON.parse(el.dataset.config ?? '{}')
    void mountRules(el, { fetch: window.fetch.bind(window), calendarCors: site.calendarCors, ...cfg })
  }
</script>

<style is:global>
  /*
   * The rules laid out as a set of rules: the version in a card, a table of
   * contents, each part under a 柿子橙 label, each chapter with a round numeral,
   * each article with its number in a column of its own (a link to itself), the
   * glossary as a two-column list. The rules text uses the body font: the subset
   * heading font carries only the large titles' characters.
   */
  .rules-root {
    margin-block-start: 1.5rem;
    max-width: 46rem;
    color: color-mix(in srgb, var(--sfb-ink) 82%, var(--sfb-mute));
    line-height: 1.8;
  }
  .rules-root p {
    margin: 0;
  }
  .rules-root a {
    color: var(--sfb-link);
    text-decoration: none;
    background: linear-gradient(var(--sfb-mark), var(--sfb-mark)) 0 100% / 100% 0.42em no-repeat;
  }
  .rules-root a:hover {
    background-size: 100% 100%;
  }

  .rules-summary {
    padding: 1.125rem 1.375rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
  }
  .rules-summary .rules-version {
    color: var(--sfb-ink);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .rules-summary .rules-changes {
    margin-top: 0.375rem;
    color: var(--sfb-mute);
    font-size: 0.9375rem;
  }
  .rules-summary .rules-changes strong {
    color: var(--sfb-ink);
    font-weight: 600;
  }

  .rules-contents {
    margin-top: 1.25rem;
    padding: 1rem 1.375rem 1.125rem;
    border-radius: 0.875rem;
    background: var(--sfb-bg-soft);
  }
  .rules-contents-title {
    color: var(--sfb-ink);
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .rules-contents ol {
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
  }
  .rules-contents > ol > li + li {
    margin-top: 0.5rem;
  }
  .rules-contents > ol > li > a {
    font-weight: 600;
    background-size: 100% 0;
  }
  .rules-contents ol ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 1rem;
    margin-top: 0.125rem;
    font-size: 0.9375rem;
  }
  .rules-contents a {
    background-size: 100% 0;
  }
  .rules-contents a:hover {
    background-size: 100% 0.42em;
  }

  .rules-body h2,
  .rules-body h3,
  .rules-older h2 {
    font-family: var(--sfb-font-body);
    color: var(--sfb-ink);
    scroll-margin-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height) + 1rem);
  }
  .rules-part {
    display: grid;
    gap: 0.25rem;
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sfb-line);
  }
  .rules-part-label {
    color: var(--sfb-highlight);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .rules-part-title {
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .rules-section {
    margin: 2.5rem 0 0;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .rules-chapter {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 2rem 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .rules-numeral {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background: var(--sfb-num-bg);
    color: var(--sfb-num-ink);
    font-size: 0.875rem;
    font-weight: 700;
  }

  /* An article: its number in a column of its own, the text beside it, each line a paragraph. */
  .rules-article {
    display: grid;
    grid-template-columns: 4.5em minmax(0, 1fr);
    column-gap: 0.75rem;
    margin-inline: -0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    scroll-margin-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height) + 1rem);
    transition: background-color 0.3s ease-out;
  }
  .rules-article + .rules-article {
    border-top: 1px dashed color-mix(in srgb, var(--sfb-line) 70%, transparent);
  }
  .rules-root .rules-article-no {
    align-self: start;
    color: var(--sfb-highlight);
    font-size: 0.9375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    background: none;
  }
  .rules-root .rules-article-no:hover {
    color: var(--sfb-link);
  }
  .rules-article-text p + p {
    margin-top: 0.375rem;
  }
  .rules-article.rules-targeted {
    background: color-mix(in srgb, var(--sfb-num-bg) 45%, var(--sfb-bg));
  }
  @media (prefers-reduced-motion: reduce) {
    .rules-article {
      transition: none;
    }
  }

  .rules-terms {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.625rem 1.25rem;
    margin: 1rem 0 0;
    padding: 1.125rem 1.375rem;
    border: 1px solid var(--sfb-line);
    border-radius: 0.875rem;
    background: var(--sfb-surface);
  }
  .rules-terms dt {
    color: var(--sfb-link);
    font-weight: 600;
    white-space: nowrap;
  }
  .rules-terms dd {
    margin: 0;
  }

  .rules-body ul {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.25rem;
  }
  .rules-body ul li::marker {
    color: var(--sfb-highlight);
  }
  .rules-body .rules-clause {
    margin-top: 0.75rem;
  }

  .rules-older {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sfb-line);
  }
  .rules-older h2 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .rules-older ul {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.25rem;
  }
  .rules-root > p:last-child {
    margin-top: 1.5rem;
  }

  /* Narrow screens: the article number sits above its text; terms stack. */
  @media (width < 36rem) {
    .rules-article {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }
    .rules-terms {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.125rem;
    }
    .rules-terms dd + dt {
      margin-top: 0.625rem;
    }
  }
</style>
