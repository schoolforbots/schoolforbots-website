{
  "name": "schoolforbots-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/subset-heading-font.mjs",
    "build:release": "node scripts/check-placeholders.mjs --release && astro build --mode release && node scripts/subset-heading-font.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:site": "vitest run --config vitest.dist.config.ts tests/dist/site",
    "verify": "npm run check && npm test && npm run build && npm run test:site",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "make:og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "@lucide/astro": "^1.72.0",
    "astro": "^7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wawoff2": "^2.0.1"
  }
}
